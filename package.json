{
  "name": "hyperplane-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Walk through a 4D world in a 3D slice: polytopes, a w-thickened Earth and a 3x3x3x3 Rubik's cube, in Slice, Stack and Shadow views.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "landmask": "node scripts/build-landmask.mjs",
    "test": "npm run test:unit && playwright test",
    "test:unit": "node --test \"tests/unit/*.test.js\""
  },
  "dependencies": {
    "three": "0.147.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "d3-geo": "3.1.1",
    "pngjs": "7.0.0",
    "topojson-client": "3.1.0",
    "vite": "5.4.10",
    "world-atlas": "2.0.2"
  }
}
